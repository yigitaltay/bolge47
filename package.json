{
  "name": "bolge47",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply bolge47-db --local",
    "db:remote": "wrangler d1 migrations apply bolge47-db --remote",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  }
}
